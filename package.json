{
	"name": "@encure/lint-format",
	"version": "0.2.0",
	"description": "Shared oxlint and oxfmt configuration for Encure projects",
	"keywords": [
		"config",
		"format",
		"lint",
		"oxc",
		"oxfmt",
		"oxlint"
	],
	"homepage": "https://github.com/encurehq/lint-format#readme",
	"bugs": "https://github.com/encurehq/lint-format/issues",
	"license": "MIT",
	"author": "Encure",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/encurehq/lint-format.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./lint": {
			"types": "./dist/lint.d.mts",
			"default": "./dist/lint.mjs"
		},
		"./format": {
			"types": "./dist/format.d.mts",
			"default": "./dist/format.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "oxlint --type-aware --type-check .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"test": "bun test",
		"publish:dry": "bun publish --dry-run --access public",
		"verify": "bun run lint && bun run format:check && bun check && bun run test"
	},
	"devDependencies": {
		"@shadcn/lint": "^0.2.1",
		"@types/bun": "^1.4.3",
		"oxfmt": "^0.60.0",
		"oxlint": "^1.80.0",
		"oxlint-tsgolint": "^0.21.1",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"@shadcn/lint": "^0.2.1",
		"oxfmt": ">=0.60.0",
		"oxlint": ">=1.75.0",
		"oxlint-tsgolint": ">=0.21.0"
	},
	"peerDependenciesMeta": {
		"@shadcn/lint": {
			"optional": true
		},
		"oxfmt": {
			"optional": true
		},
		"oxlint": {
			"optional": true
		},
		"oxlint-tsgolint": {
			"optional": true
		}
	}
}
